---
// Progressive disclosure for the long-form body copy.
//
// The narrative is the one block a reader scanning for opening hours does not
// want, so it starts collapsed. Crucially the text is rendered into the HTML at
// build time and merely hidden by the browser's own <details> behaviour — no
// JavaScript, no fetch on expand. Crawlers and LLM fetchers parse the full DOM
// and get every word; only the human gets the shorter page.
//
// Do not "improve" this by loading the content on click. That turns honest
// progressive disclosure into content the machines can no longer see, which is
// the entire thing this page is built to avoid.
import { ui, type Lang } from "../lib/i18n";

interface Props {
  lang: Lang;
  html: string;
  /** Open by default where the long copy is the reason people arrived. */
  open?: boolean;
}

const { lang, html, open = false } = Astro.props;
const U = ui(lang);
---

{html && (
  <details class="more" open={open}>
    <summary>{U.moreAbout}</summary>
    <div class="prose" set:html={html} />
  </details>
)}

<style>
  .more {
    margin: 32px 0;
    border-top: 1px solid rgba(44, 62, 80, 0.12);
    border-bottom: 1px solid rgba(44, 62, 80, 0.12);
  }
  summary {
    cursor: pointer;
    padding: 16px 0;
    font-size: 15px;
    font-weight: 500;
    color: var(--storm);
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::before {
    content: "＋";
    font-size: 14px;
    color: var(--driftwood);
  }
  .more[open] summary::before {
    content: "−";
  }
  summary:hover {
    color: var(--deep);
  }
  .prose {
    padding-bottom: 8px;
  }
  .prose :global(h2) {
    font-size: 20px;
    margin: 24px 0 10px;
  }
  .prose :global(h3) {
    font-size: 17px;
    margin: 20px 0 8px;
  }
  .prose :global(p) {
    font-size: 16px;
    line-height: 1.75;
    margin-bottom: 16px;
  }
  .prose :global(ul) {
    margin: 0 0 16px 20px;
    font-size: 16px;
    line-height: 1.75;
  }
  .prose :global(li) {
    margin-bottom: 6px;
  }
</style>
