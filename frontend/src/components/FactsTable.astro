---
// Practical facts as a table. This is the block answer engines lift most
// readily, and the only one where "distance from the house" — information that
// exists nowhere else — sits next to the source's own details.
import { hostname, publishableFacts } from "../lib/facts";
import { ui, type Lang } from "../lib/i18n";
import type { Fact } from "../lib/types";

interface Props {
  lang: Lang;
  facts: Fact[];
  heading?: string;
}

const { lang, facts, heading } = Astro.props;
const U = ui(lang);

const rows = publishableFacts(facts);
const sources = [...new Set(rows.map((f) => f.source_url).filter((u): u is string => !!u))];
---

{rows.length > 0 && (
  <section class="facts">
    <h2>{heading ?? U.factsHeading}</h2>
    <table>
      <tbody>
        {rows.map((f) => (
          <tr>
            <th scope="row">{f.label}</th>
            <td>{f.value}</td>
          </tr>
        ))}
      </tbody>
    </table>
    {sources.length > 0 && (
      <p class="src">
        {U.sources}:
        {sources.map((u, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={u} target="_blank" rel="noopener noreferrer nofollow">{hostname(u)}</a>
          </>
        ))}
      </p>
    )}
  </section>
)}

<style>
  .facts {
    margin: 32px 0;
  }
  .facts h2 {
    font-size: 22px;
    margin-bottom: 12px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  tr {
    border-bottom: 1px solid rgba(44, 62, 80, 0.1);
  }
  tr:last-child {
    border-bottom: none;
  }
  th {
    text-align: left;
    font-weight: 500;
    color: var(--driftwood);
    padding: 10px 16px 10px 0;
    width: 42%;
    vertical-align: top;
  }
  td {
    padding: 10px 0;
    vertical-align: top;
  }
  .src {
    margin-top: 10px;
    font-size: 12px;
    color: var(--driftwood);
  }
  .src a {
    margin-left: 4px;
  }
  @media (max-width: 520px) {
    th {
      width: 50%;
      padding-right: 10px;
    }
  }
</style>
