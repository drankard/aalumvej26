---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import HouseCrossSell from "../components/HouseCrossSell.astro";
import FactsTable from "../components/FactsTable.astro";
import Faq from "../components/Faq.astro";
import FromHouse from "../components/FromHouse.astro";
import MoreDetail from "../components/MoreDetail.astro";
import { creditedDomains, hostname } from "../lib/facts";
import { fromHouse } from "../lib/fromHouse";
import { absoluteImage, pageImage } from "../lib/images";
import { getContent } from "../lib/content";
import { LANGS, langPrefix, loc, pickTr, ui, type Lang } from "../lib/i18n";
import { renderMarkdown } from "../lib/markdown";
import { SITE, TAG_COLORS } from "../lib/site";
import type { CategoryTranslation, Post, PostTranslation } from "../lib/types";

interface Props {
  lang: Lang;
  post: Post;
  slug: string;
}

const { lang, post, slug } = Astro.props;
const L = loc(lang);
const U = ui(lang);
const p = langPrefix(lang);
const { posts, categories, postSlugs } = await getContent();

const tr = pickTr<PostTranslation>(post.translations, lang);
const tag = (L.tags as Record<string, string>)[post.tag_key] ?? post.tag_key;
const bg = TAG_COLORS[post.tag_key] || "#5A7A8A";
const category = categories.find((c) => c.id === post.category);
const catLabel = category
  ? (pickTr<CategoryTranslation>(category.translations, lang).label ?? category.id)
  : post.category;

const sources = [...new Set([post.url, ...(post.source_urls || [])].filter(Boolean))];
const related = posts
  .filter((po) => po.category === post.category && po.id !== post.id)
  .slice(0, 3);

const basePath = `/oplevelser/${slug}/`;
const canonical = `${SITE}${p}${basePath}`;
const title = `${tr.title} — ${L.nav.experiences} · Nationalpark Thy`;
const description = (tr.tldr || tr.excerpt || tr.title || "").slice(0, 300);

const bodyHtml = renderMarkdown(tr.body);
const facts = tr.facts ?? [];
const faq = tr.faq ?? [];

// Only credit domains the facts table hasn't already named, so a page sourced
// from a single site doesn't print that site twice.
const img = pageImage(slug);

const credited = creditedDomains(facts);
const extraSources = sources.filter((u) => !credited.has(hostname(u)));

// Dated items describe an Event; everything else is a place you can visit.
// event_start is authoritative — tag_key alone was never reliable.
const isEvent = Boolean(post.event_start) || post.tag_key === "event" || post.tag_key === "bigEvent";

// The region is the most specific location we can assert truthfully: the
// pipeline stores no venue address, and inventing one would be the same error
// as inventing an opening time.
const regionPlace = {
  "@type": "Place",
  name: "Nationalpark Thy",
  address: { "@type": "PostalAddress", addressRegion: "Nordjylland", addressCountry: "DK" },
};

const primaryEntity =
  isEvent && post.event_start
    ? {
        "@context": "https://schema.org",
        "@type": "Event",
        name: tr.title,
        description: tr.tldr || tr.excerpt || "",
        url: canonical,
        startDate: post.event_start,
        ...(img ? { image: absoluteImage(img.src) } : {}),
        ...(post.event_end ? { endDate: post.event_end } : {}),
        eventStatus: "https://schema.org/EventScheduled",
        eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
        location: regionPlace,
      }
    : {
        "@context": "https://schema.org",
        "@type": "TouristAttraction",
        name: tr.title,
        description: tr.tldr || tr.excerpt || "",
        url: canonical,
        touristType: catLabel,
        containedInPlace: regionPlace,
        // Asserted only when we hold a photo that actually shows this place.
        ...(img ? { image: absoluteImage(img.src) } : {}),
      };

const jsonLd: object[] = [
  primaryEntity,
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    url: canonical,
    name: tr.title,
    inLanguage: lang,
    datePublished: post.created_at,
    dateModified: post.updated_at,
    isPartOf: { "@type": "WebSite", name: "Aalumvej 26", url: `${SITE}/` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: U.backHome, item: `${SITE}${p}/` },
      { "@type": "ListItem", position: 2, name: L.nav.experiences, item: `${SITE}${p}/oplevelser/` },
      { "@type": "ListItem", position: 3, name: tr.title, item: canonical },
    ],
  },
];

if (faq.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  });
}
---

<Base
  lang={lang}
  title={title}
  description={description}
  basePath={basePath}
  ogType="article"
  ogImage={img ? absoluteImage(img.src) : undefined}
  jsonLd={jsonLd}
>
  <main class="page">
    <article class="container">
      <Breadcrumbs
        lang={lang}
        trail={[{ label: L.nav.experiences, href: `${p}/oplevelser/` }, { label: tr.title }]}
      />
      <div class="meta">
        <span class="tag" style={`background:${bg}`}>{tag}</span>
        {tr.date && <span class="date">{tr.date}</span>}
        {category && (
          <a class="cat" href={`${p}/oplevelser/kategori/${category.id}/`}>
            {category.icon} {catLabel}
          </a>
        )}
      </div>
      <h1>{post.emoji} {tr.title}</h1>
      {/* The excerpt stays on cards and in the meta description. Repeating it
          here under the tldr gave the reader two paragraphs of the same thing. */}
      {img && (
        <img class="hero" src={img.src} alt={img.alt} width="820" height="460" loading="eager" />
      )}
      <p class="lead">{tr.tldr || tr.excerpt}</p>
      <FactsTable lang={lang} facts={facts} />
      <MoreDetail lang={lang} html={bodyHtml} />
      <FromHouse lang={lang} text={fromHouse(slug, lang, tr.from_house)} />
      <Faq lang={lang} items={faq} />
      <HouseCrossSell lang={lang} />
      {extraSources.length > 0 && (
        <p class="attribution">
          {U.sourceNote}:
          {extraSources.map((u, i) => (
            <>
              {i > 0 && <span aria-hidden="true"> · </span>}
              <a href={u} target="_blank" rel="noopener noreferrer nofollow">{hostname(u)}</a>
            </>
          ))}
        </p>
      )}
      <p class="updated">
        {U.updatedLabel}:
        <time datetime={post.updated_at.slice(0, 10)}>{post.updated_at.slice(0, 10)}</time>
      </p>
      {related.length > 0 && (
        <section class="related">
          <h2>{U.related}</h2>
          <div class="cards">
            {related.map((r, i) => (
              <ExperienceCard post={r} lang={lang} slug={postSlugs.get(r.id)!} idx={i} />
            ))}
          </div>
        </section>
      )}
      <p class="langs">
        {U.otherLangs}:
        {LANGS.filter((x) => x !== lang).map((x) => (
          <a href={`${langPrefix(x)}${basePath}`}>{x.toUpperCase()}</a>
        ))}
      </p>
    </article>
  </main>
</Base>

<style>
  .page {
    padding: 110px 28px 72px;
    background: var(--foam);
  }
  article.container {
    max-width: 820px;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .date {
    font-size: 12px;
    color: var(--driftwood);
  }
  .cat {
    font-size: 12px;
    color: var(--storm);
    text-decoration: none;
    background: rgba(44, 62, 80, 0.06);
    padding: 3px 12px;
    border-radius: 100px;
  }
  h1 {
    font-size: clamp(26px, 4vw, 40px);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 14px;
  }
  .hero {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
    margin-bottom: 20px;
  }
  .lead {
    font-size: 19px;
    line-height: 1.6;
    margin-bottom: 14px;
  }
  .attribution,
  .updated {
    margin-top: 18px;
    font-size: 12px;
    color: var(--driftwood);
  }
  .attribution a {
    margin-left: 4px;
  }
  .related h2 {
    font-size: 22px;
    margin-bottom: 12px;
  }
  .related {
    margin-top: 48px;
  }
  .related .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
  }
  .langs {
    margin-top: 40px;
    font-size: 12px;
    color: var(--driftwood);
  }
  .langs a {
    margin-left: 10px;
  }
</style>
