---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import AreaCard from "../components/AreaCard.astro";
import HouseCrossSell from "../components/HouseCrossSell.astro";
import FactsTable from "../components/FactsTable.astro";
import Faq from "../components/Faq.astro";
import FromHouse from "../components/FromHouse.astro";
import MoreDetail from "../components/MoreDetail.astro";
import { hostname } from "../lib/facts";
import { fromHouse } from "../lib/fromHouse";
import { absoluteImage, pageImage } from "../lib/images";
import { getContent } from "../lib/content";
import { LANGS, langPrefix, loc, pickTr, ui, type Lang } from "../lib/i18n";
import { renderMarkdown } from "../lib/markdown";
import { HOUSE_NAME, SITE } from "../lib/site";
import type { Area, AreaTranslation } from "../lib/types";

interface Props {
  lang: Lang;
  area: Area;
  slug: string;
}

const { lang, area, slug } = Astro.props;
const L = loc(lang);
const U = ui(lang);
const p = langPrefix(lang);
const { areas, areaSlugs } = await getContent();

const tr = pickTr<AreaTranslation>(area.translations, lang);
const others = areas.filter((a) => a.id !== area.id).slice(0, 3);

const basePath = `/omraadet/${slug}/`;
const canonical = `${SITE}${p}${basePath}`;
const title = `${tr.name} — ${L.nav.area} · Agger, Thy`;
const description = (tr.desc || tr.name || "").slice(0, 300);

const img = pageImage(slug);
const bodyHtml = renderMarkdown(tr.body);
const facts = tr.facts ?? [];
const faq = tr.faq ?? [];

const jsonLd: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    name: tr.name,
    description: tr.desc || "",
    url: canonical,
    ...(img ? { image: absoluteImage(img.img.src) } : {}),
    containedInPlace: {
      "@type": "Place",
      name: "Nationalpark Thy",
      address: { "@type": "PostalAddress", addressRegion: "Nordjylland", addressCountry: "DK" },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    url: canonical,
    name: tr.name,
    inLanguage: lang,
    datePublished: area.created_at,
    dateModified: area.updated_at,
    isPartOf: { "@type": "WebSite", name: HOUSE_NAME, url: `${SITE}/` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: U.backHome, item: `${SITE}${p}/` },
      { "@type": "ListItem", position: 2, name: L.nav.area, item: `${SITE}${p}/omraadet/` },
      { "@type": "ListItem", position: 3, name: tr.name, item: canonical },
    ],
  },
];

if (faq.length > 0) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  });
}
---

<Base
  lang={lang}
  title={title}
  description={description}
  basePath={basePath}
  ogType="article"
  ogImage={img?.img}
  jsonLd={jsonLd}
>
  <main class="page">
    <article class="container">
      <Breadcrumbs
        lang={lang}
        trail={[{ label: L.nav.area, href: `${p}/omraadet/` }, { label: tr.name }]}
      />
      <div class="meta">
        {tr.dist && <span class="dist">{U.distance}: {tr.dist}</span>}
      </div>
      <h1>{tr.name}</h1>
      {img && (
        <Picture
          class="hero"
          src={img.img}
          alt={img.alt}
          formats={["webp"]}
          width={1230}
          widths={[420, 820, 1230]}
          sizes="(max-width: 860px) 100vw, 820px"
          loading="eager"
        />
      )}
      <p class="lead">{tr.desc}</p>
      <FactsTable lang={lang} facts={facts} />
      <MoreDetail lang={lang} html={bodyHtml} />
      <FromHouse lang={lang} text={fromHouse(slug, lang, tr.from_house)} />
      <Faq lang={lang} items={faq} />
      <HouseCrossSell lang={lang} />
      {area.url && (
        <p class="attribution">
          {U.sourceNote}:
          <a href={area.url} target="_blank" rel="noopener noreferrer nofollow">
            {hostname(area.url)}
          </a>
        </p>
      )}
      <p class="updated">
        {U.updatedLabel}:
        <time datetime={area.updated_at.slice(0, 10)}>{area.updated_at.slice(0, 10)}</time>
      </p>
      {others.length > 0 && (
        <section class="related">
          <h2>{U.allAreas}</h2>
          <div class="cards">
            {others.map((o) => (
              <AreaCard area={o} lang={lang} slug={areaSlugs.get(o.id)!} />
            ))}
          </div>
        </section>
      )}
      <p class="langs">
        {U.otherLangs}:
        {LANGS.filter((x) => x !== lang).map((x) => (
          <a href={`${langPrefix(x)}${basePath}`}>{x.toUpperCase()}</a>
        ))}
      </p>
    </article>
  </main>
</Base>

<style>
  .page {
    padding: 110px 28px 72px;
    background: var(--foam);
  }
  article.container {
    max-width: 820px;
  }
  .meta {
    margin-bottom: 10px;
  }
  .dist {
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--rust);
  }
  h1 {
    font-size: clamp(26px, 4vw, 40px);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 14px;
  }
  /* <Picture> wraps the hero in a <picture>, so the wrapper takes the flow
     box and the <img> inside it is what gets shaped. */
  :global(picture:has(> .hero)) {
    display: block;
    margin-bottom: 20px;
  }
  :global(.hero) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 6px;
  }
  .lead {
    font-size: 19px;
    line-height: 1.6;
    margin-bottom: 22px;
  }
  .attribution,
  .updated {
    margin-top: 18px;
    font-size: 12px;
    color: var(--driftwood);
  }
  .attribution a {
    margin-left: 4px;
  }
  .related {
    margin-top: 48px;
  }
  .related h2 {
    font-size: 22px;
    margin-bottom: 12px;
  }
  .related .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 14px;
  }
  .langs {
    margin-top: 40px;
    font-size: 12px;
    color: var(--driftwood);
  }
  .langs a {
    margin-left: 10px;
  }
</style>
