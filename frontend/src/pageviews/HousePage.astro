---
// The house's own page.
//
// Previously the house existed only as a section on the home page, which left
// the site's most commercially valuable query ("stråtækt feriehus Agger") with
// no dedicated URL to rank. This page is the primary source for everything
// about the property, so it carries the full VacationRental markup while the
// home page keeps a summary LodgingBusiness reference pointing here.
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FactsTable from "../components/FactsTable.astro";
import Faq from "../components/Faq.astro";
import { langPrefix, loc, ui, type Lang } from "../lib/i18n";
import { BOOKING, HOUSE_IMAGES, HOUSE_NAME, SITE } from "../lib/site";
import {
  HOUSE_FACTS,
  HOUSE_FAQ,
  HOUSE_INTRO,
  HOUSE_SIZE_M2,
  houseNode,
} from "../lib/house";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const L = loc(lang);
const U = ui(lang);
const p = langPrefix(lang);

const basePath = "/huset/";
const canonical = `${SITE}${p}${basePath}`;
const title = `${U.houseTitle} — Ålumvej 26`;
const description = HOUSE_INTRO[lang].slice(0, 300);

const facts = HOUSE_FACTS[lang];
const faq = HOUSE_FAQ[lang];

const jsonLd: object[] = [
  {
    // The shared definition, plus the fields only this page carries. The home
    // page emits the same node; anything they both state lives in houseNode so
    // the two cannot drift apart.
    ...(await houseNode(lang)),
    floorSize: { "@type": "QuantitativeValue", value: HOUSE_SIZE_M2, unitCode: "MTK" },
    amenityFeature: L.features.map((f: string) => ({
      "@type": "LocationFeatureSpecification",
      // Locale feature strings are emoji-prefixed for display; the emoji is
      // presentation, not part of the amenity name.
      name: f.replace(/^\p{Extended_Pictographic}️?\s*/u, ""),
      value: true,
    })),
    isPartOf: { "@type": "WebSite", name: HOUSE_NAME, url: `${SITE}${p}/` },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: U.backHome, item: `${SITE}${p}/` },
      { "@type": "ListItem", position: 2, name: U.houseNav, item: canonical },
    ],
  },
];
---

<Base
  lang={lang}
  title={title}
  description={description}
  basePath={basePath}
  ogType="article"
  ogImage={HOUSE_IMAGES[0].img}
  jsonLd={jsonLd}
>
  <main class="page">
    <article class="container">
      <Breadcrumbs lang={lang} trail={[{ label: U.houseNav }]} />
      <div class="kicker">{L.house.address}</div>
      <h1>{U.houseTitle}</h1>
      <p class="lead">{HOUSE_INTRO[lang]}</p>

      <div class="gallery">
        {HOUSE_IMAGES.map((img, i) => (
          <Picture
            src={img.img}
            alt={img.alt}
            formats={["webp"]}
            width={480}
            widths={[240, 480]}
            sizes="(max-width: 640px) 100vw, 240px"
            loading={i === 0 ? "eager" : "lazy"}
          />
        ))}
      </div>

      <FactsTable lang={lang} facts={facts} />

      <section class="amenities">
        <h2>{L.house.heading1} {L.house.heading2}</h2>
        <p>{L.house.description}</p>
        <ul>
          {L.features.map((f: string) => <li>{f}</li>)}
        </ul>
      </section>

      <Faq lang={lang} items={faq} />

      <section class="booking">
        <h2>{U.bookCta}</h2>
        <p>{L.house.bookingNote}</p>
        <a class="btn btn-deep" href={BOOKING} target="_blank" rel="noopener noreferrer">
          {L.house.bookBtn}
        </a>
      </section>
    </article>
  </main>
</Base>

<style>
  .page {
    padding: 110px 28px 72px;
    background: var(--foam);
  }
  article.container {
    max-width: 860px;
  }
  h1 {
    font-size: clamp(26px, 4vw, 40px);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 14px;
  }
  .lead {
    font-size: 19px;
    line-height: 1.6;
    margin-bottom: 28px;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 10px;
    margin-bottom: 32px;
  }
  .gallery :global(picture img) {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 4px;
  }
  .amenities {
    margin: 36px 0;
  }
  .amenities h2,
  .booking h2 {
    font-size: 22px;
    margin-bottom: 12px;
  }
  .amenities p {
    font-size: 16px;
    line-height: 1.75;
    margin-bottom: 16px;
  }
  .amenities ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 8px;
    font-size: 15px;
  }
  .booking {
    margin-top: 44px;
    padding: 26px;
    background: rgba(44, 62, 80, 0.05);
    border-radius: 6px;
  }
  .booking p {
    font-size: 15px;
    line-height: 1.7;
    margin-bottom: 16px;
  }
</style>
