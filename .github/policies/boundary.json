{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CeilingAllowsApplicationWork",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "DenyIdentityControlPlane",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "organizations:*",
        "account:*",
        "sso:*",
        "sso-directory:*",
        "identitystore:*"
      ],
      "Resource": "*"
    }
  ]
}
